NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional live AI provider for lesson analysis.
# Leave all four empty to use the clearly-labelled mock analyser (no cost, no
# network). Set AI_PROVIDER=openai-compatible and fill the rest to switch to a
# live /chat/completions endpoint. These are server-only: never prefix them with
# NEXT_PUBLIC_, or the key would ship to the browser.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
