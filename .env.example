NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional live AI provider -----------------------------------------------
# Leave AI_PROVIDER empty to use the clearly-labelled mock analyser (no cost, no
# network). These values are server-only: never prefix them with NEXT_PUBLIC_.

# Google Gemini — the native Gemini API, no OpenAI account involved.
#   AI_PROVIDER=gemini
#   GEMINI_API_KEY=<key from https://aistudio.google.com/apikey>
#   AI_MODEL=<a Gemini model your key can use, see
#             https://ai.google.dev/gemini-api/docs/models>
# AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
# AI_BASE_URL may override https://generativelanguage.googleapis.com.
#
# Any other OpenAI-shaped endpoint (a local model, another vendor):
#   AI_PROVIDER=openai-compatible   plus AI_BASE_URL, AI_API_KEY, AI_MODEL
#
# After editing this file, restart the dev server and run `npm run check:live`
# to make one real call before relying on it.
AI_PROVIDER=
GEMINI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
